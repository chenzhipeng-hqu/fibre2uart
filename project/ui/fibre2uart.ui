<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x><y>0</y><width>1280</width><height>900</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size><width>1024</width><height>768</height></size>
  </property>
  <property name="windowTitle">
   <string>fibre2uart — 光纤通信管理工具</string>
  </property>
  <!-- 菜单栏 -->
  <widget class="QMenuBar" name="menuBar">
   <property name="geometry">
    <rect><x>0</x><y>0</y><width>1280</width><height>24</height></rect>
   </property>
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>文件(&amp;F)</string></property>
    <addaction name="actionConnect"/>
    <addaction name="actionDisconnect"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title"><string>帮助(&amp;H)</string></property>
    <addaction name="actionAbout"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuHelp"/>
  </widget>
  <!-- 工具栏 -->
  <widget class="QToolBar" name="toolBar">
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <addaction name="actionConnect"/>
   <addaction name="actionDisconnect"/>
   <addaction name="separator"/>
   <addaction name="actionScan"/>
  </widget>
  <!-- 状态栏 -->
  <widget class="QStatusBar" name="statusBar"/>
  <!-- 主内容区 -->
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
    <property name="spacing"><number>2</number></property>
    <property name="contentsMargins"><number>4</number><number>4</number><number>4</number><number>4</number></property>
    <!-- 连接栏 -->
    <item>
     <layout class="QHBoxLayout" name="hLayoutConn">
      <item>
       <widget class="QLabel" name="labelPort">
        <property name="text"><string>串口:</string></property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="comboPort">
        <property name="minimumWidth"><number>160</number></property>
        <property name="editable"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelBaud">
        <property name="text"><string>波特率:</string></property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="comboBaud">
        <property name="currentIndex"><number>6</number></property>
        <item><property name="text"><string>9600</string></property></item>
        <item><property name="text"><string>38400</string></property></item>
        <item><property name="text"><string>57600</string></property></item>
        <item><property name="text"><string>115200</string></property></item>
        <item><property name="text"><string>230400</string></property></item>
        <item><property name="text"><string>460800</string></property></item>
        <item><property name="text"><string>921600</string></property></item>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnConnect">
        <property name="text"><string>连接</string></property>
        <property name="minimumWidth"><number>80</number></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnScan">
        <property name="text"><string>扫描设备</string></property>
        <property name="minimumWidth"><number>100</number></property>
        <property name="enabled"><bool>false</bool></property>
       </widget>
      </item>
      <item>
       <spacer>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="labelStatus">
        <property name="text"><string>● 未连接</string></property>
        <property name="styleSheet"><string>color: gray;</string></property>
       </widget>
      </item>
     </layout>
    </item>
    <!-- 主分割器（上/下） -->
    <item>
     <widget class="QSplitter" name="splitterMain">
      <property name="orientation"><enum>Qt::Vertical</enum></property>
      <property name="childrenCollapsible"><bool>false</bool></property>
      <!-- 上半：左右分割 -->
      <widget class="QSplitter" name="splitterTop">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="childrenCollapsible"><bool>false</bool></property>
       <!-- 左侧：设备树 + 拓扑图标签页 -->
       <widget class="QTabWidget" name="tabLeft">
        <property name="minimumWidth"><number>300</number></property>
        <widget class="QWidget" name="tabDeviceTree">
         <attribute name="title"><string>设备树</string></attribute>
         <layout class="QVBoxLayout" name="vLayoutDeviceTree">
          <property name="contentsMargins"><number>0</number><number>0</number><number>0</number><number>0</number></property>
          <!-- DeviceTreeView 占位（main_window.py 替换为真实 widget） -->
          <item>
           <widget class="QTreeWidget" name="deviceTreeWidget">
            <column><property name="text"><string>设备 / 地址 / 状态</string></property></column>
           </widget>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="tabTopology">
         <attribute name="title"><string>拓扑图</string></attribute>
         <layout class="QVBoxLayout" name="vLayoutTopology">
          <property name="contentsMargins"><number>0</number><number>0</number><number>0</number><number>0</number></property>
          <!-- TopologyView 占位 -->
          <item>
           <widget class="QGraphicsView" name="topologyView"/>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="tabRouteTable">
         <attribute name="title"><string>路由表</string></attribute>
         <layout class="QVBoxLayout" name="vLayoutRoute">
          <property name="contentsMargins"><number>0</number><number>0</number><number>0</number><number>0</number></property>
          <item>
           <widget class="QTableWidget" name="routeTableWidget">
            <column><property name="text"><string>逻辑地址</string></property></column>
            <column><property name="text"><string>路由路径</string></property></column>
            <column><property name="text"><string>has485</string></property></column>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <!-- 右侧：详情 + 操作标签页 -->
       <widget class="QTabWidget" name="tabRight">
        <property name="minimumWidth"><number>400</number></property>
        <!-- 节点详情 -->
        <widget class="QWidget" name="tabNodeDetail">
         <attribute name="title"><string>节点详情</string></attribute>
         <layout class="QFormLayout" name="formNodeDetail">
          <item row="0" column="0">
           <widget class="QLabel" name="lblModelLabel"><property name="text"><string>型号:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QLabel" name="lblModel"><property name="text"><string>—</string></property></widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblUuidLabel"><property name="text"><string>UUID:</string></property></widget>
          </item>
          <item row="1" column="1">
           <widget class="QLabel" name="lblUuid"><property name="text"><string>—</string></property></widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblAddrLabel"><property name="text"><string>逻辑地址:</string></property></widget>
          </item>
          <item row="2" column="1">
           <widget class="QLabel" name="lblAddr"><property name="text"><string>—</string></property></widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="lblPortPathLabel"><property name="text"><string>路由路径:</string></property></widget>
          </item>
          <item row="3" column="1">
           <widget class="QLabel" name="lblPortPath"><property name="text"><string>—</string></property></widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="lblPortsLabel"><property name="text"><string>端口信息:</string></property></widget>
          </item>
          <item row="4" column="1">
           <widget class="QLabel" name="lblPorts">
            <property name="text"><string>—</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
        <!-- 单指令发送 -->
        <widget class="QWidget" name="tabCommandPanel">
         <attribute name="title"><string>单指令</string></attribute>
         <layout class="QVBoxLayout" name="vLayoutCmd">
          <item>
           <layout class="QFormLayout" name="formCmd">
            <item row="0" column="0">
             <widget class="QLabel"><property name="text"><string>逻辑地址:</string></property></widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="cmdAddr"><property name="placeholderText"><string>0x0001</string></property></widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel"><property name="text"><string>CMD (hex):</string></property></widget>
            </item>
            <item row="1" column="1">
             <widget class="QLineEdit" name="cmdCode"><property name="placeholderText"><string>0x25</string></property></widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel"><property name="text"><string>Data (hex):</string></property></widget>
            </item>
            <item row="2" column="1">
             <widget class="QLineEdit" name="cmdData"><property name="placeholderText"><string>00</string></property></widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QPushButton" name="btnSendCmd">
            <property name="text"><string>发 送</string></property>
           </widget>
          </item>
          <item>
           <widget class="QTextEdit" name="cmdResult">
            <property name="readOnly"><bool>true</bool></property>
            <property name="placeholderText"><string>响应结果将显示在此...</string></property>
           </widget>
          </item>
         </layout>
        </widget>
        <!-- 升级面板 -->
        <widget class="QWidget" name="tabUpgrade">
         <attribute name="title"><string>固件升级</string></attribute>
         <layout class="QVBoxLayout" name="vLayoutUpgrade">
          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QLabel"><property name="text"><string>固件文件:</string></property></widget>
            </item>
            <item>
             <widget class="QLineEdit" name="upgradeFilePath"><property name="readOnly"><bool>true</bool></property></widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnChooseFile"><property name="text"><string>选择...</string></property></widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QLabel"><property name="text"><string>目标:</string></property></widget>
            </item>
            <item>
             <widget class="QComboBox" name="upgradeTarget">
              <item><property name="text"><string>广播（选中节点）</string></property></item>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QProgressBar" name="upgradeProgress">
            <property name="value"><number>0</number></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="upgradeStatusLabel">
            <property name="text"><string>就绪</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QPushButton" name="btnStartUpgrade"><property name="text"><string>开始升级</string></property></widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnRetryUpgrade">
              <property name="text"><string>重 试</string></property>
              <property name="enabled"><bool>false</bool></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </widget>
      </widget>
      <!-- 中部：终端口列表 -->
      <widget class="QWidget" name="widgetTerminal">
       <property name="maximumHeight"><number>220</number></property>
       <layout class="QVBoxLayout" name="vLayoutTerminal">
        <property name="contentsMargins"><number>0</number><number>0</number><number>0</number><number>0</number></property>
        <item>
         <widget class="QLabel" name="labelTerminalTitle">
          <property name="text"><string>终端口 / 虚拟串口列表</string></property>
          <property name="styleSheet"><string>font-weight:bold;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QTableWidget" name="terminalTable">
          <column><property name="text"><string>逻辑地址</string></property></column>
          <column><property name="text"><string>类型</string></property></column>
          <column><property name="text"><string>波特率</string></property></column>
          <column><property name="text"><string>TX</string></property></column>
          <column><property name="text"><string>RX</string></property></column>
          <column><property name="text"><string>溢出</string></property></column>
          <column><property name="text"><string>虚拟串口</string></property></column>
          <column><property name="text"><string>操作</string></property></column>
         </widget>
        </item>
       </layout>
      </widget>
      <!-- 底部：日志 -->
      <widget class="QWidget" name="widgetLog">
       <property name="maximumHeight"><number>200</number></property>
       <layout class="QVBoxLayout" name="vLayoutLog">
        <property name="contentsMargins"><number>0</number><number>0</number><number>0</number><number>0</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QLabel" name="labelLogTitle">
            <property name="text"><string>日志</string></property>
            <property name="styleSheet"><string>font-weight:bold;</string></property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="logLevelCombo">
            <item><property name="text"><string>DEBUG</string></property></item>
            <item><property name="text"><string>INFO</string></property></item>
            <item><property name="text"><string>WARNING</string></property></item>
            <item><property name="text"><string>ERROR</string></property></item>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnClearLog">
            <property name="text"><string>清空</string></property>
           </widget>
          </item>
          <item>
           <spacer>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QPlainTextEdit" name="logViewer">
          <property name="readOnly"><bool>true</bool></property>
          <property name="font">
           <font><family>Monospace</family><pointsize>9</pointsize></font>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
